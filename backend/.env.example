# Outpost backend env template. Committed; contains no secrets.
# Copy to backend/.env and fill in the blanks. backend/.env is gitignored.
# Read by app/config.py (pydantic-settings). OS env vars override this file.
# A blank value (FOO=) counts as unset: the default applies, and a required
# var left blank fails at startup.

# --- App ---------------------------------------------------------------
# Required. Browser origin of the frontend, used for the CORS allowlist.
# Local: http://localhost:3000. Prod: your Vercel domain (https://<app>.vercel.app).
FRONTEND_URL=http://localhost:3000
# Optional. Free-form label (dev / prod). Tags Langfuse traces. Default: dev.
ENVIRONMENT=dev
# Optional. Log level (debug / info / warning / error). Default: info.
LOG_LEVEL=info

# --- Supabase ----------------------------------------------------------
# Required. Supabase dashboard -> Project Settings -> API -> Project URL.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Required (secret). Supabase dashboard -> Project Settings -> API -> JWT Settings
# -> JWT Secret. Used for HS256 tokens; ES256/RS256 tokens verify via JWKS.
SUPABASE_JWT_SECRET=
# Required (secret). Supabase dashboard -> Project Settings -> API keys ->
# service_role key. Server-side only; never ship it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres ----------------------------------------------------------
# Required. Must use the psycopg3 driver prefix (postgresql+psycopg://).
# Remote: Supabase dashboard -> Connect -> Direct connection (port 5432):
#   postgresql+psycopg://postgres:<DB-PASSWORD>@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
# Local (`supabase start`, password "postgres"):
#   postgresql+psycopg://postgres:postgres@localhost:54322/postgres
# docker compose overrides this to host.docker.internal:54322 regardless.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:54322/postgres

# --- LLM provider (OpenRouter, Anthropic-compatible Messages API) ------
# Required (secret) unless ANTHROPIC_API_KEY is set. OpenRouter dashboard ->
# Keys (https://openrouter.ai/settings/keys). Falls back to ANTHROPIC_API_KEY.
LLM_API_KEY=
# Optional. Blank = Anthropic direct (https://api.anthropic.com). The SDK
# appends /v1/messages, so this resolves to https://openrouter.ai/api/v1/messages.
LLM_BASE_URL=https://openrouter.ai/api
# Optional. x-api-key (Anthropic) or bearer (OpenRouter). Default: x-api-key.
LLM_AUTH_SCHEME=bearer
# Optional. Model for debate, autonomous actions and eval judges.
# Default: claude-haiku-4-5-20251001. V4.1 Flash often drops or empties the
# propose_action tool inputs, so the debate runs on V4 Pro pinned below.
# Tested with the flat submit_debate format on 2026-10-22: xiaomi/mimo-v2.6-flash,
# deepseek/deepseek-v4.1-flash-1017, openai/gpt-6-luna (see docs/PLAN.md).
LLM_MODEL_FAST=deepseek/deepseek-v4-pro-0813
# Optional. OpenRouter provider order for the fast/tool-calling model only
# (debate + autonomous; narration and eval judges stay unpinned).
# Comma-separated; the listed hosts are tried in order and nothing else
# (allow_fallbacks=false). Requires LLM_BASE_URL on openrouter.ai, else
# startup fails. Blank = OpenRouter picks the host. Default: none.
LLM_PROVIDER_ORDER=StreamLake,Novita
# Optional. Model for end-of-turn narration. Default: claude-sonnet-4-6.
LLM_MODEL_NARRATION=deepseek/deepseek-v4.1-flash
# Optional. true sends thinking={"type":"disabled"} on every call (OpenRouter
# maps it to reasoning.enabled=false). DeepSeek V4.1 Flash reasons by default;
# keep this true for the DeepSeek models. Default: false.
LLM_DISABLE_THINKING=true
# Optional. JSON prices in cents per million tokens for models missing from
# app/agent/constants.py MODEL_PRICING, or to override an entry. Example:
# {"vendor/model":{"input":10,"cache_write":10,"cache_read":1,"output":40}}
# Unpriced models fail at startup. Default: none.
LLM_PRICING_OVERRIDES=

# --- Anthropic (legacy / optional) -------------------------------------
# Only needed when calling Anthropic directly: leave LLM_API_KEY blank,
# LLM_BASE_URL blank, LLM_AUTH_SCHEME=x-api-key, and set the LLM_MODEL_*
# vars to Claude ids (or blank for the defaults). Anthropic Console -> API Keys.
# With bearer auth this key is never sent to OpenRouter.
ANTHROPIC_API_KEY=

# --- Budget rails ------------------------------------------------------
# Optional. Per-turn cost ceiling in cents; above it narration is skipped.
MAX_COST_CENTS_PER_TURN=15
# Optional. Per-run cost ceiling in cents.
MAX_COST_CENTS_PER_RUN=40
# Optional. Narration toggle. Read into Settings but not currently
# consulted by any node. Default: true.
SONNET_NARRATION_ENABLED=true

# --- Dev ---------------------------------------------------------------
# Optional. true skips the one-run-per-day gate (unlimited runs). Startup
# fails if set while ENVIRONMENT is not dev/development/local/test, so it
# can't leak into production. Default: false.
DEV_BYPASS_DAILY_GATE=false

# --- Observability -----------------------------------------------------
# Optional. Langfuse tracing; both keys blank disables it.
# cloud.langfuse.com -> project -> Settings -> API Keys.
LANGFUSE_PUBLIC_KEY=
# Optional (secret). Same page as the public key.
LANGFUSE_SECRET_KEY=
# Optional. Langfuse host. Default: https://cloud.langfuse.com.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional (secret). LangSmith agentevals, used by CI evals.
# smith.langchain.com -> Settings -> API Keys.
LANGSMITH_API_KEY=

# --- Test / eval flags (shell env only) --------------------------------
# These are read with os.environ by tests and scripts, NOT through Settings,
# so this file does not set them for `uv run pytest`. Export them in the
# shell (or prefix the command) when you need them. Listed for reference.
# OUTPOST_EVAL_REAL_LLM=1            # run the real-LLM eval in tests/eval
# OUTPOST_EVAL_BUDGET_CENTS=50       # per-run ceiling asserted by that eval
# OUTPOST_PLAYTEST_REAL_LLM=1        # real-LLM playtest smoke
# OUTPOST_AXIS_BASELINE_CAPTURE=1    # recapture tests/eval axis baseline
# OUTPOST_GIT_SHA=<sha>              # stamped into playtest archives
# SUPABASE_ANON_KEY=                 # Supabase -> Project Settings -> API keys -> anon;
#                                    # enables tests/test_integration_supabase_jwks.py
