# Outpost backend env — committed template, all values blank.
# Real values live in backend/.env (gitignored).
#
# NOTE: NEXT_PUBLIC_* keys will move to frontend/.env.local when the
# frontend is scaffolded in Phase 2. Kept here during Phase 0 as a
# single source of truth.

ENVIRONMENT=development

# --- Supabase ----------------------------------------------------------
# Project ref: find in Supabase dashboard URL: /dashboard/project/<ref>
SUPABASE_URL=
SUPABASE_PROJECT_REF=

# Public-scoped key, shipped to the browser. Prefer the new
# sb_publishable_... format over the legacy anon JWT.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret keys — server-side only, never commit.
# service_role bypasses RLS; treat like a root password.
SUPABASE_SERVICE_ROLE_KEY=

# Used by FastAPI + PyJWT to validate Supabase-issued JWTs (HS256).
SUPABASE_JWT_SECRET=

# --- Postgres (direct connection, not via PostgREST) -------------------
# Format: postgresql+psycopg://postgres:<PASSWORD>@db.<REF>.supabase.co:5432/postgres
# Password was set at project creation. Reset under Settings → Database.
DATABASE_URL=

# --- Anthropic ---------------------------------------------------------
ANTHROPIC_API_KEY=

# Toggle Sonnet narration (cost fallback). Default on; flip to false to
# degrade to Haiku-only if per-run cost drifts above target.
SONNET_NARRATION_ENABLED=true

# --- Langfuse ----------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Google OAuth (configured in Supabase dashboard, not read here) ----
# Left blank — Supabase handles the OAuth dance server-side.
# Recorded for reference only.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
