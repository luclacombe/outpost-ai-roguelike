# Outpost backend env template — committed, all secrets blank.
# Copy to backend/.env and fill in real values. backend/.env is gitignored.

# --- Supabase ----------------------------------------------------------
# Local dev (via `supabase start`): port 54322, password "postgres"
# Production: postgresql+psycopg://postgres:<PASSWORD>@db.<REF>.supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@host.docker.internal:54322/postgres
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- Anthropic ---------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# Toggle Sonnet narration (cost fallback). Flip to false to degrade to Haiku-only
# if per-run cost drifts above target.
SONNET_NARRATION_ENABLED=true

# --- Langfuse (optional — empty disables tracing) ----------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- LangSmith agentevals (optional, CI only) --------------------------
LANGSMITH_API_KEY=

# --- App ---------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=dev
LOG_LEVEL=info
